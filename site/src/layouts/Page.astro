---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/space-grotesk/latin-400.css';
import '@fontsource/space-grotesk/latin-500.css';
import '@fontsource/space-grotesk/latin-600.css';
import '../styles/global.css';
import { explanations } from '../lib/explanations';
interface Props {
  title: string;
  description: string;
  page: 'home' | 'leaderboard';
}
const { title, description, page } = Astro.props;
import { base, site } from '../lib/site';
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;
const socialImage = Astro.site
  ? new URL(`${base}/social-card.png`, Astro.site).href
  : undefined;
const schema = {
  '@context': 'https://schema.org',
  '@type': page === 'home' ? 'WebSite' : 'WebPage',
  name: title,
  description,
  ...(canonical ? { url: canonical } : {}),
  about: {
    '@type': 'Thing',
    name: 'AI agent evaluation in shared cloud infrastructure',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080f19" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={Astro.site ? 'index, follow' : 'noindex, nofollow'}
    />
    <title>{site.title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && (
      <>
        <meta property="og:image" content={socialImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta
          property="og:image:alt"
          content="CloudGym: Can AI agents manage shared cloud infrastructure? 102 cases, 19 AWS services, 65 resource types."
        />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-banner">
      <nav class="container banner-nav" aria-label="Main navigation">
        <a class="banner-brand" href={`${base}/`} aria-label="CloudGYM home">
          Cloud<span>GYM</span>
        </a>
        <div class="banner-links">
          <a
            href={`${base}/`}
            aria-current={page === 'home' ? 'page' : undefined}
          >
            Home
          </a>
          <a
            href={`${base}/leaderboard/`}
            aria-current={page === 'leaderboard' ? 'page' : undefined}
          >
            Leaderboard
          </a>
        </div>
        <a
          class="banner-github"
          href={site.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="CloudGYM on GitHub"
        >
          <img src={`${base}/icons/github.svg`} width="22" height="22" alt="" />
        </a>
      </nav>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    {Object.entries(explanations).map(([topic, text]) => (
      <div id={`help-${topic}`} class="help-tooltip" role="tooltip" hidden>
        {text}
      </div>
    ))}
    <script>
      import '../scripts/tooltips';
    </script>
  </body>
</html>
